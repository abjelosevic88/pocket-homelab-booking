{
  "name": "Pocket Booking",
  "short_name": "Booking",
  "description": "Booking pages people use to pick a free time with you. Bookings go on to your calendar, contacts and other Pocket apps.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#087f5b",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "To confirm",
      "url": "/?view=pending"
    },
    {
      "name": "Booking pages",
      "url": "/types"
    },
    {
      "name": "Hours & days off",
      "url": "/hours"
    }
  ]
}
