[Unit]
Description=Pocket Booking — booking pages on your own server
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-booking
Group=pocket-booking
ExecStart=/usr/local/bin/pocket-booking
Environment=DATA_DIR=/var/lib/pocket-booking
Environment=PORT=8080
Environment=BASE_URL=https://booking.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-booking
PrivateTmp=true

[Install]
WantedBy=multi-user.target
